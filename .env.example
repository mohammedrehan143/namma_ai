# ==============================================================================
# Namma AI — Environment Configuration Example
# ==============================================================================
# Copy this file to .env in your root and backend/frontend directories as needed.
# NEVER commit real credentials to version control.

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=namma-ai-super-secret-key-change-in-production-2026

# Database (PostgreSQL / Supabase or SQLite fallback for local development)
DATABASE_URL=sqlite:///./namma_ai.db
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/namma_ai
# Example Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase (Optional for direct storage and auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Configuration (local | supabase | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET_NAME=namma-evidence

# AI & LLM Provider (Google Gemini / OpenAI / Anthropic / Mock)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-or-openai-api-key
LLM_MODEL=gemini-1.5-flash
# Alternative: gpt-4o-mini, claude-3-5-sonnet, mock
VISION_MODEL=gemini-1.5-flash
EMBEDDINGS_MODEL=text-embedding-004

# Telephony: Exotel (PSTN/DID) & Asterisk PBX
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_VIRTUAL_NUMBER=080XXXXXXXX
EXOTEL_SIP_GATEWAY=sip.exotel.com
ASTERISK_HOST=127.0.0.1
ASTERISK_PORT=5060

# Voice Processing (STT & TTS)
STT_PROVIDER=faster-whisper
STT_SERVICE_URL=http://127.0.0.1:8000/v1/audio/transcriptions
TTS_PROVIDER=piper
TTS_SERVICE_URL=http://127.0.0.1:5000/api/tts

# WhatsApp Messaging via n8n
N8N_WHATSAPP_WEBHOOK_URL=https://your-n8n.instance/webhook/whatsapp-outbound

# Maps Provider (mapbox | google | osm)
MAPS_PROVIDER=osm
MAPS_API_KEY=your-maps-api-key

# SLA Configuration Defaults (in hours)
SLA_HOURS_CRITICAL=4
SLA_HOURS_HIGH=24
SLA_HOURS_MEDIUM=48
SLA_HOURS_LOW=72

# Frontend Public Variables (Next.js)
NEXT_PUBLIC_API_BASE_URL=https://namma-ai.onrender.com/api
NEXT_PUBLIC_MAPS_KEY=your-public-maps-key
