# Namma AI Frontend Environment Variables
# Copy this file to .env.local for local development, or configure in Vercel Project Settings for production.

# Production: Point to your deployed Render backend service (with /api suffix)
NEXT_PUBLIC_API_BASE_URL=https://namma-ai.onrender.com/api

# Optional: Mapbox or Google Maps API key (leave blank for default OpenStreetMap)
NEXT_PUBLIC_MAPS_KEY=
